# Copia este archivo como `.env.local` y llena los valores reales.
# `.env.local` está en .gitignore y nunca se sube al repositorio.

# API key de Google Gemini (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Datos de la empresa compradora que aparecen en las órdenes de compra
VITE_EMPRESA_RAZON_SOCIAL=EMPRESA DEMO S.A. DE C.V.
VITE_EMPRESA_RFC=XAXX010101000
VITE_EMPRESA_DIRECCION=Calle Ejemplo 100, Col. Centro, C.P. 00000
VITE_EMPRESA_LOCALIDAD=Localidad (Fiscal), Ciudad, Estado, MÉXICO
VITE_EMPRESA_TELEFONO=Tel: 000-000-0000
VITE_EMPRESA_CELULAR=Cel: 000-000-0000
VITE_EMPRESA_EMAIL=compras@ejemplo.com
